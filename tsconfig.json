{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "module": "preserve",
    "moduleResolution": "bundler"
  },
  "include": [
    "src/**/*.mjs",
    "src/**/*.d.ts",
    "web/**/*.ts",
    "web/**/*.tsx"
  ]
}
